m_w = 558;
m_d = m_w/11;

module edge(r, h){
    $fn=36;
    union(){
        sphere(r=r);
        cylinder(h=h,r=r);
    };
};

module box_outer(r,h,w){
    w=w-2*r;
    translate([r,r,r]) hull(){
        translate([0 ,0 ,0]) edge(r,h);
        translate([w,0 ,0]) edge(r,h);
        translate([0 ,w,0]) edge(r,h);
        translate([w,w,0]) edge(r,h);
    };
};

module box(r,h,w){
    t = 0.5;
    difference(){
        box_outer(r,h,w);
        translate([t,t,t]) box_outer(r-t,h+t,w-t*2);
    };
};

box(5,5,m_d);
