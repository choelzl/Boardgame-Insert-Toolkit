m_w = 558;
m_d = m_w/11;

module edge(r, h){
    $fn=36;
    union(){
        sphere(r=r);
        cylinder(h=h,r=r);
    };
};

module box_outer(r,h,wx,wy){
    wx=wx-2*r;
    wy=wy-2*r;
    translate([r,r,r]) hull(){
        translate([0 ,0 ,0]) edge(r,h);
        translate([wx,0 ,0]) edge(r,h);
        translate([0 ,wy,0]) edge(r,h);
        translate([wx,wy,0]) edge(r,h);
    };
};

module box(h,dim){
    r = 5;
    t = 1;
    difference(){
        box_outer(r,h,m_d*dim[0],m_d*dim[1]);
        translate([t,t,t]) box_outer(r-t,h+t,m_d*dim[0]-t*2, m_d*dim[1]-t*2);
    };
};

box(20,[2,1]);
